# App Environment
APP_ENV=development
DOCKER_TARGET=dev
DOCKER_CMD=air

# Database config
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=

# JWT (DUAL TOKEN PATTERN - USE DIFFERENT SECRETS FOR SECURITY)
ACCESS_TOKEN_KEY=your-access-token-secret-change-in-production
REFRESH_TOKEN_KEY=your-refresh-token-secret-change-in-production
ACCESS_TOKEN_EXPIRATION=15m    # 15 MINUTES FOR ACCESS TOKEN (SHORT-LIVED)
REFRESH_TOKEN_EXPIRATION=168h  # 7 DAYS FOR REFRESH TOKEN (LONG-LIVED)

# Seed database on startup (true/false)
# Set to false after first run - only use true for initial setup
DB_SEED=false

# Role constants (Database roles only)
# Note: "Public" is not a database role - it represents non-authenticated users
ROLE_SUPER_ADMIN="Super Admin"
ROLE_ADMIN_ESELON_1="Admin Eselon 1"
ROLE_VERIFICATOR_ESELON_1="Verificator Eselon 1"
ROLE_ADMIN_BALAI="Admin Balai"
ROLE_VERIFICATOR_BALAI="Verificator Balai"
ROLE_SURVEYOR="Surveyor"
ROLE_USER="User"

# Resource constants
RESOURCE_NEGARA="Negara"
RESOURCE_PENGEMBANG="Pengembang"
RESOURCE_SWADAYA="Swadaya"
RESOURCE_GOTONGROYONG="Gotong Royong"

# Banned Words
BANNED_WORDS="banned,words,example"

# CORS configuration
CORS_ALLOW_ORIGINS="http://localhost:5173,http://localhost:8080,http://182.23.160.30:8080"

# Central Browser SSO (local development)
# Production URLs are deployment-specific and must be configured separately.
SSO_BROWSER_ENABLED=false
SSO_BASE_URL=http://127.0.0.1:18082
SSO_CLIENT_ID=klinik-pkp-web
SSO_REDIRECT_URI=http://localhost:3000/auth/sso/callback
SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
SSO_FLOW_TTL=5m
# Required when SSO_BROWSER_ENABLED=true: base64-encoded random key, minimum 32 bytes.
SSO_FLOW_HMAC_KEY=
# Must match Central's SSO_KLINIK_INTROSPECTION_SECRET; minimum 32 characters.
SSO_INTROSPECTION_SECRET=
