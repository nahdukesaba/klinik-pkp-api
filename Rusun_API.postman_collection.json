{
  "info": {
    "name": "Rusun API Collection",
    "_postman_id": "rusun-api-collection",
    "description": "Complete API collection for Rusun (Rumah Susun) endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public Endpoints",
      "item": [
        {
          "name": "Get All Rusun",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rusun?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "rusun"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page"
                },
                {
                  "key": "province_id",
                  "value": "12",
                  "disabled": true,
                  "description": "Filter by province"
                },
                {
                  "key": "regency_id",
                  "value": "1275",
                  "disabled": true,
                  "description": "Filter by regency"
                },
                {
                  "key": "status",
                  "value": "active",
                  "disabled": true,
                  "description": "Filter by status"
                },
                {
                  "key": "search",
                  "value": "medan",
                  "disabled": true,
                  "description": "Search term"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Rusun by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rusun/1",
              "host": ["{{base_url}}"],
              "path": ["api", "rusun", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Get Rusun by Province",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rusun/province/12",
              "host": ["{{base_url}}"],
              "path": ["api", "rusun", "province", "12"]
            }
          },
          "response": []
        },
        {
          "name": "Get Rusun Map Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rusun/map?province_id=12",
              "host": ["{{base_url}}"],
              "path": ["api", "rusun", "map"],
              "query": [
                {
                  "key": "province_id",
                  "value": "12",
                  "description": "Filter by province (optional)"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rusun/statistics?province_id=12",
